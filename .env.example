# QuickTools Environment Variables

# Server Configuration
PORT=5000

# Database Configuration
# Replace with your MongoDB Atlas connection string for production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quicktools

# Authentication
# Replace with a strong secret key in production
JWT_SECRET=your-strong-secret-key-for-production

# File Storage
# Local storage paths are used by default
# For production, consider using cloud storage services
UPLOAD_DIR=uploads
CONVERTED_DIR=uploads/converted