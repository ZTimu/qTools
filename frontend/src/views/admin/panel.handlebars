            <!-- System Settings Section -->
            <section id="settings-section" class="admin-section">
                <h2>System Settings</h2>
                
                <form id="settingsForm" class="admin-form">
                    <div class="form-group">
                        <label for="siteName">Site Name:</label>
                        <input type="text" id="siteName" name="siteName" value="{{settings.siteName}}">
                    </div>
                    
                    <div class="form-group">
                        <label for="siteDescription">Site Description:</label>
                        <textarea id="siteDescription" name="siteDescription">{{settings.siteDescription}}</textarea>
                    </div>
                    
                    <div class="form-group">
                        <label for="maintenanceMode">Maintenance Mode:</label>
                        <select id="maintenanceMode" name="maintenanceMode">
                            <option value="off" {{#if (eq settings.maintenanceMode "off")}}selected{{/if}}>Off</option>
                            <option value="on" {{#if (eq settings.maintenanceMode "on")}}selected{{/if}}>On</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label for="defaultLanguage">Default Language:</label>
                        <select id="defaultLanguage" name="defaultLanguage">
                            <option value="en" {{#if (eq settings.defaultLanguage "en")}}selected{{/if}}>English</option>
                            <option value="bn" {{#if (eq settings.defaultLanguage "bn")}}selected{{/if}}>Bengali</option>
                        </select>
                    </div>
                    
                    <button type="submit" class="admin-btn">Save Settings</button>
                </form>
            </section>
            
            <!-- Activity Logs Section -->
            <section id="logs-section" class="admin-section">
                <h2>Activity Logs</h2>
                
                <div class="admin-actions-bar">
                    <div class="filter-group">
                        <label for="logType">Filter by Type:</label>
                        <select id="logType">
                            <option value="all">All</option>
                            <option value="user">User</option>
                            <option value="system">System</option>
                            <option value="error">Error</option>
                        </select>
                    </div>
                    
                    <div class="filter-group">
                        <label for="logDate">Filter by Date:</label>
                        <input type="date" id="logDate">
                    </div>
                    
                    <button id="clearLogsBtn" class="admin-btn danger">Clear Logs</button>
                </div>
                
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Type</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>IP Address</th>
                            <th>Date/Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each logs}}
                        <tr class="log-{{this.type}}">
                            <td>{{this._id}}</td>
                            <td>{{this.type}}</td>
                            <td>{{this.user}}</td>
                            <td>{{this.action}}</td>
                            <td>{{this.ipAddress}}</td>
                            <td>{{formatDate this.createdAt}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </section>
        </div>
    </div>
</div>

