<div class="landing-container">
    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <h1>Quick Tools for Everyday Tasks</h1>
                <p>Boost your productivity with our collection of essential online tools - all in one place.</p>
                <div class="hero-buttons">
                    {{#if isLoggedIn}}
                    <a href="/dashboard" class="btn btn-primary">Dashboard</a>
                    {{else}}
                    <a href="/login" class="btn btn-primary">Get Started</a>
                    {{/if}}
                    <a href="#features" class="btn btn-secondary">Learn More</a>
                </div>
            </div>
            <div class="hero-image">
                <img src="/img/hero-illustration.svg" alt="QuickTools Illustration" onerror="this.src='/img/hero-fallback.png'; this.onerror=null;">
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features" id="features">
        <div class="container">
            <h2 class="section-title">Our Tools</h2>
            <p class="section-description">Explore our powerful suite of productivity tools.</p>
            
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-file-pdf"></i>
                    </div>
                    <h3>PDF to Word</h3>
                    <p>Convert PDF documents into editable Word files with our easy-to-use tool.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-image"></i>
                    </div>
                    <h3>Image to Text</h3>
                    <p>Extract text from images using our advanced OCR technology.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-qrcode"></i>
                    </div>
                    <h3>QR Generator</h3>
                    <p>Create QR codes for links, text, and more in seconds.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-exchange-alt"></i>
                    </div>
                    <h3>Currency Converter</h3>
                    <p>Convert between various world currencies with real-time rates.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-thermometer-half"></i>
                    </div>
                    <h3>Unit Converter</h3>
                    <p>Convert between temperature, mass, and other units effortlessly.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-calculator"></i>
                    </div>
                    <h3>Calculator</h3>
                    <p>Perform basic and advanced calculations with our versatile calculator.</p>
                </div>
            </div>
        </div>
    </section>
    
    <!-- How It Works Section -->
    <section class="how-it-works">
        <div class="container">
            <h2 class="section-title">How It Works</h2>
            <div class="steps">
                <div class="step">
                    <div class="step-number">1</div>
                    <h3>Create an Account</h3>
                    <p>Sign up for free and gain access to all our tools.</p>
                </div>
                <div class="step">
                    <div class="step-number">2</div>
                    <h3>Choose a Tool</h3>
                    <p>Select from our collection of productivity tools.</p>
                </div>
                <div class="step">
                    <div class="step-number">3</div>
                    <h3>Get Results</h3>
                    <p>Get instant results and boost your productivity.</p>
                </div>
            </div>
        </div>
    </section>
    
    <!-- CTA Section -->
    <section class="cta">
        <div class="container">
            <h2>Ready to Get Started?</h2>
            <p>Join thousands of users who boost their productivity every day.</p>
            <div class="cta-buttons">
                {{#if isLoggedIn}}
                <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
                {{else}}
                <a href="/register" class="btn btn-primary">Sign Up Now</a>
                <a href="/login" class="btn btn-secondary">Sign In</a>
                {{/if}}
            </div>
        </div>
    </section>
</div>

