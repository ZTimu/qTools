<div class="tool-container">
    <div class="tool-header">
        <h2>Image to Text (OCR)</h2>
        <p>Extract text from images using OCR technology</p>
    </div>

    <div class="tool-content">
        <form id="imageToTextForm" enctype="multipart/form-data" class="conversion-form">
            <div class="form-group">
                <label for="imageFile">Select Image File</label>
                <input type="file" id="imageFile" name="imageFile" accept=".jpg,.jpeg,.png,.gif,.bmp" required>
            </div>
            
            <div class="form-options">
                <h3>OCR Options</h3>
                <div class="option-group">
                    <label>
                        <input type="checkbox" name="enhanceImage" checked>
                        Enhance Image Quality
                    </label>
                </div>
                <div class="option-group">
                    <label>
                        <input type="checkbox" name="detectLanguage" checked>
                        Auto-Detect Language
                    </label>
                </div>
                <div class="option-group">
                    <label for="language">Select Language (if auto-detect is off):</label>
                    <select id="language" name="language">
                        <option value="eng">English</option>
                        <option value="ben">Bengali</option>
                        <option value="hin">Hindi</option>
                        <option value="ara">Arabic</option>
                        <option value="spa">Spanish</option>
                        <option value="fra">French</option>
                    </select>
                </div>
            </div>
            
            <button type="submit" class="convert-btn">Extract Text</button>
        </form>
        
        <div class="conversion-status" style="display: none;">
            <div class="progress-container">
                <div class="progress-bar"></div>
            </div>
            <p class="status-text">Processing your image...</p>
        </div>
        
        <div class="conversion-result" style="display: none;">
            <h3>Text Extraction Complete!</h3>
            <div class="result-text-container">
                <textarea id="extractedText" class="extracted-text" readonly></textarea>
            </div>
            <div class="result-actions">
                <button id="copyText" class="action-btn">Copy Text</button>
                <a href="#" id="downloadText" class="action-btn">Download as TXT</a>
            </div>
        </div>
        
        <div class="error-message" style="display: none; color: var(--error-color); margin-top: 16px;"></div>
    </div>
    
    <div class="back-link">
        <a href="/dashboard">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const imageForm = document.getElementById('imageToTextForm');
    const statusElement = document.querySelector('.conversion-status');
    const resultElement = document.querySelector('.conversion-result');
    const errorElement = document.querySelector('.error-message');
    const submitButton = imageForm.querySelector('button[type="submit"]');
    const extractedTextElement = document.getElementById('extractedText');
    const downloadTextLink = document.getElementById('downloadText');
    const copyTextButton = document.getElementById('copyText');
    
    imageForm.addEventListener('submit', async function(event) {
        event.preventDefault();
        
        // Clear previous states
        statusElement.style.display = 'none';
        resultElement.style.display = 'none';
        errorElement.style.display = 'none';
        errorElement.textContent = '';
        extractedTextElement.value = '';
        
        // Get the file input
        const fileInput = document.getElementById('imageFile');
        const file = fileInput.files[0];
        
        // Validate file
        if (!file) {
            errorElement.textContent = 'Please select an image file';
            errorElement.style.display = 'block';
            return;
        }
        
        if (!file.type.startsWith('image/')) {
            errorElement.textContent = 'Only image files are allowed';
            errorElement.style.display = 'block';
            return;
        }
        
        // Create form data
        const formData = new FormData();
        formData.append('imageFile', file);
        
        // Add options
        formData.append('enhanceImage', document.querySelector('[name="enhanceImage"]').checked);
        formData.append('detectLanguage', document.querySelector('[name="detectLanguage"]').checked);
        formData.append('language', document.getElementById('language').value);
        
        // Show loading state
        const originalText = submitButton.textContent;
        submitButton.textContent = 'Processing...';
        submitButton.disabled = true;
        statusElement.style.display = 'block';
        
        // Send the request with a timeout
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 60000); // 60 second timeout
        
        try {
            console.log('Sending image for OCR:', file.name, file.size, file.type);
            const apiUrl = getApiUrl(CONFIG.ENDPOINTS.TOOLS.IMAGE_TO_TEXT);
            console.log('Using API URL:', apiUrl);
            
            // Send the request
            const response = await fetch(apiUrl, {
                method: 'POST',
                body: formData,
                signal: controller.signal
            });
            
            // Clear timeout
            clearTimeout(timeoutId);
            
            // Reset button state
            submitButton.textContent = originalText;
            submitButton.disabled = false;
            statusElement.style.display = 'none';
            
            console.log('Response status:', response.status, response.statusText);
            
            if (!response.ok) {
                // Try to get detailed error
                let errorMessage = `Server responded with ${response.status}: ${response.statusText}`;
                try {
                    const errorData = await response.json();
                    console.error('Error data:', errorData);
                    if (errorData.error) {
                        errorMessage = errorData.error;
                    }
                } catch (parseError) {
                    console.error('Error parsing error response:', parseError);
                }
                throw new Error(errorMessage);
            }
            
            // Parse the response
            const data = await response.json();
            console.log('OCR response received:', data);
            
            // Display the extracted text (even if OCR wasn't fully successful)
            extractedTextElement.value = data.text || 'No text could be extracted from this image.';
            
            // Setup download link with the full URL
            downloadTextLink.href = getApiUrl(data.downloadLink);
            downloadTextLink.download = file.name.replace(/\.[^/.]+$/, '') + '_ocr.txt';
            
            // Setup copy button
            copyTextButton.addEventListener('click', function() {
                extractedTextElement.select();
                document.execCommand('copy');
                
                // Show a temporary "Copied!" message
                const originalButtonText = this.textContent;
                this.textContent = 'Copied!';
                setTimeout(() => {
                    this.textContent = originalButtonText;
                }, 2000);
            });
            
            resultElement.style.display = 'block';
        } catch (error) {
            // Clear timeout if it's an abort error
            clearTimeout(timeoutId);
            
            console.error('Error extracting text from image:', error);
            
            // Check if it's a timeout
            if (error.name === 'AbortError') {
                errorElement.textContent = 'Request timed out. The server took too long to process your image. Try a clearer or smaller image.';
            } else {
                // Regular error
                errorElement.textContent = error.message || 'Error processing image. Please try again later.';
            }
            
            // Reset button state
            submitButton.textContent = originalText;
            submitButton.disabled = false;
            statusElement.style.display = 'none';
            
            errorElement.style.display = 'block';
        }
    });
});
</script>

<style>
.form-options {
    margin: 20px 0;
    padding: 16px;
    background-color: var(--secondary-color);
    border-radius: 6px;
}

.form-options h3 {
    margin-bottom: 12px;
    font-size: 1.1rem;
    color: var(--text-color);
}

.option-group {
    margin-bottom: 10px;
}

.option-group label {
    display: flex;
    align-items: center;
    cursor: pointer;
}

.option-group input[type="checkbox"] {
    width: auto;
    margin-right: 8px;
}

.result-text-container {
    margin-bottom: 16px;
}

.extracted-text {
    width: 100%;
    min-height: 200px;
    padding: 12px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background-color: var(--secondary-color);
    color: var(--text-color);
    font-family: monospace;
    resize: vertical;
}

.progress-container {
    height: 8px;
    background-color: var(--secondary-color);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 12px;
}

.progress-bar {
    height: 100%;
    background-color: var(--accent-color);
    width: 0;
    animation: progress 2s infinite;
}

@keyframes progress {
    0% { width: 0; }
    50% { width: 70%; }
    100% { width: 100%; }
}

.conversion-result h3 {
    color: var(--success-color);
    margin-bottom: 16px;
}

.result-actions {
    display: flex;
    gap: 12px;
}

.action-btn {
    padding: 10px 16px;
    background-color: var(--accent-color);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
}

.action-btn:hover {
    background-color: #3a5bef;
}

.back-link {
    margin-top: 24px;
    text-align: center;
}

.back-link a {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.back-link a:hover {
    text-decoration: underline;
}
</style>